# Copier en .env (jamais commité : .gitignore et gitleaks le surveillent) puis remplacer chaque valeur.
# Générer les secrets avec : openssl rand -hex 32 (hexadécimal : sans caractère qui casserait une URL de connexion)

# Nom de domaine public du site (sans https://). « localhost » pour un essai local.
SITE_DOMAIN=localhost
# Image à déployer (publiée par .github/workflows/release.yml). Sans valeur : construite localement.
APP_IMAGE=ghcr.io/vincenttisseront/ipnoria-website:latest

# Secrets
POSTGRES_PASSWORD=change-me
IP_HASH_SALT=change-me

# Conservation des messages de contact (jours) avant purge automatique
CONTACT_RETENTION_DAYS=365

# Notification par e-mail des nouveaux messages (facultatif : vide = messages seulement en base)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=

# Mentions légales (obligatoires en France, LCEN art. 6)
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_HOST=

# Espace d'administration /admin (OpenID Connect). Vide = désactivé.
SESSION_PASSWORD=
ADMIN_EMAILS=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Démo publique (lecture seule). Vide = page « démo sur rendez-vous ».
DEMO_URL=
DEMO_USER=
DEMO_PASSWORD=

# Réservation de démonstrations (/rendez-vous). Nécessite la base et le SMTP.
BOOKING_ENABLED=false
BOOKING_TIMEZONE=Europe/Paris
BOOKING_DAYS=1,2,3,4,5
BOOKING_TIMES=10:00,14:00,16:00
BOOKING_DURATION_MIN=30
BOOKING_HORIZON_DAYS=14
BOOKING_MIN_NOTICE_HOURS=24
# Lien de visio fixe ajouté aux invitations.
BOOKING_MEETING_URL=
# Adresse iCalendar secrète de votre agenda : ses occupations bloquent les créneaux.
BOOKING_BUSY_ICS_URL=
# Clé (24 caractères ou plus) du flux /api/booking/feed.ics?key=... à abonner dans votre agenda.
BOOKING_FEED_KEY=

# Statistiques Umami (docker compose --profile analytics). Vide = aucune mesure.
ANALYTICS_SRC=
ANALYTICS_WEBSITE_ID=
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=

# Comptes utilisateurs (feuille de route : proposer, voter, commenter). Nécessite la base et le SMTP.
# Secret de 32 caractères ou plus (openssl rand -hex 32) : chiffre les secrets des applications d'authentification.
# Ne le changez pas une fois des comptes créés : leurs applications d'authentification ne fonctionneraient plus.
ACCOUNTS_SECRET=
# Refuser les mots de passe connus dans des fuites (Have I Been Pwned, k-anonymat) : true ou false.
ACCOUNTS_BREACH_CHECK=true
# Connexion GitHub (facultative) : application OAuth, URL de retour https://<domaine>/api/account/github/callback
ACCOUNTS_GITHUB_CLIENT_ID=
ACCOUNTS_GITHUB_CLIENT_SECRET=
