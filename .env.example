# Copier en .env (jamais commité : .gitignore et gitleaks le surveillent) puis remplacer chaque valeur.
# Générer les secrets avec : openssl rand -hex 32 (hexadécimal : sans caractère qui casserait une URL de connexion)

# Nom de domaine public du site (sans https://). « localhost » pour un essai local.
SITE_DOMAIN=localhost
# Image à déployer (publiée par .github/workflows/release.yml). Sans valeur : construite localement.
APP_IMAGE=ghcr.io/vincenttisseront/ipnoria-website:latest

# Secrets
POSTGRES_PASSWORD=change-me
IP_HASH_SALT=change-me

# Conservation des messages de contact (jours) avant purge automatique
CONTACT_RETENTION_DAYS=365

# Notification par e-mail des nouveaux messages (facultatif : vide = messages seulement en base)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=

# Mentions légales (obligatoires en France, LCEN art. 6)
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_HOST=

# Espace d'administration /admin (OpenID Connect). Vide = désactivé.
SESSION_PASSWORD=
ADMIN_EMAILS=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Démo publique (lecture seule). Vide = page « démo sur rendez-vous ».
DEMO_URL=
DEMO_USER=
DEMO_PASSWORD=

# Statistiques Umami (docker compose --profile analytics). Vide = aucune mesure.
ANALYTICS_SRC=
ANALYTICS_WEBSITE_ID=
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=
