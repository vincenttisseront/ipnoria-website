# Proxy HTTPS (certificat Let's Encrypt automatique ; pour SITE_DOMAIN=localhost, certificat local de Caddy).
# Let's Encrypt n'exige pas d'adresse e-mail (et n'envoie plus d'avis d'expiration) : aucune n'est configurée.
{
	servers {
		protocols h1 h2 h3
	}
}

# Pages d'erreur autonomes (caddy-errors/, générées par tools/caddy_errors.py) : servies par Caddy quand
# l'application ne répond pas (redémarrage, mise à jour), et page de maintenance tant que le fichier
# caddy-errors/maintenance.on existe. Les erreurs rendues par l'application gardent ses propres pages.
(pages_erreur) {
	@maintenance file {
		root /srv/errors
		try_files /maintenance.on
	}
	handle @maintenance {
		root * /srv/errors
		@en_m path /en /en/*
		rewrite @en_m /en/maintenance.html
		rewrite * /maintenance.html
		header Retry-After 300
		header Cache-Control no-store
		header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		file_server {
			status 503
		}
	}
	handle_errors 502 503 504 {
		root * /srv/errors
		@en path /en /en/*
		rewrite @en /en/50x.html
		rewrite * /50x.html
		header Retry-After 60
		header Cache-Control no-store
		header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		templates
		file_server
	}
}

(application) {
	encode zstd gzip
	import pages_erreur

	handle {
		# X-Forwarded-For : Caddy remplace toute valeur envoyée par le client par sa vraie adresse (aucun proxy
		# déclaré de confiance) ; l'application s'y fie pour la limitation de débit. Ne pas ajouter trusted_proxies.
		reverse_proxy app:3000
	}

	header {
		-Server
		-Via
	}

	log {
		output stdout
		format json
	}
}

# Nom externe (Let's Encrypt). Le nom interne, s'il existe, est un fichier déposé dans /etc/caddy/sites/.
{$SITE_DOMAIN} {
	import application
}

# Sites additionnels (statistiques…) : un fichier .caddy par site, déposé par Ansible selon les options choisies
import /etc/caddy/sites/*.caddy
