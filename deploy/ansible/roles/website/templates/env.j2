# {{ ansible_managed }}
SITE_DOMAIN={{ website_domain }}
APP_IMAGE={{ website_image }}
POSTGRES_PASSWORD={{ vault_postgres_password }}
IP_HASH_SALT={{ vault_ip_hash_salt }}
CONTACT_RETENTION_DAYS={{ website_contact_retention_days | default(365) }}

SMTP_HOST={{ website_smtp_host | default('') }}
SMTP_PORT={{ website_smtp_port | default(587) }}
SMTP_SECURE={{ website_smtp_secure | default(false) | string | lower }}
SMTP_USER={{ vault_smtp_user | default('') }}
SMTP_PASS={{ vault_smtp_pass | default('') }}
SMTP_FROM="{{ website_smtp_from | default('') }}"
SMTP_TO={{ website_smtp_to | default('') }}

LEGAL_ADDRESS="{{ website_legal_address | default('') }}"
LEGAL_EMAIL={{ website_legal_email | default('') }}
LEGAL_HOST="{{ website_legal_host | default('') }}"

SESSION_PASSWORD={{ vault_session_password | default('') }}
ADMIN_EMAILS={{ website_admin_emails | default([]) | join(',') }}
OIDC_ISSUER={{ website_oidc_issuer | default('') }}
OIDC_CLIENT_ID={{ website_oidc_client_id | default('') }}
OIDC_CLIENT_SECRET={{ vault_oidc_client_secret | default('') }}

DEMO_URL={{ website_demo_url | default('') }}
DEMO_USER={{ website_demo_user | default('') }}
DEMO_PASSWORD={{ website_demo_password | default('') }}

{% if website_analytics_enabled %}
ANALYTICS_SRC=https://stats.{{ website_domain }}/script.js
ANALYTICS_WEBSITE_ID={{ website_analytics_website_id | default('') }}
UMAMI_DB_PASSWORD={{ vault_umami_db_password }}
UMAMI_APP_SECRET={{ vault_umami_app_secret }}
{% endif %}
