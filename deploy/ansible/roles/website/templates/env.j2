# {{ ansible_managed }}
SITE_DOMAIN={{ website_domain }}
SITE_APEX={{ website_domain[4:] if website_domain is match('^www\\.') else website_domain }}
APP_IMAGE={{ website_image }}
POSTGRES_PASSWORD={{ vault_postgres_password }}
IP_HASH_SALT={{ vault_ip_hash_salt }}
CONTACT_RETENTION_DAYS={{ website_contact_retention_days | default(365) }}

SMTP_HOST={{ website_smtp_host | default('') }}
SMTP_PORT={{ website_smtp_port | default(587) }}
SMTP_SECURE={{ website_smtp_secure | default(false) | string | lower }}
SMTP_USER={{ vault_smtp_user | default('') }}
SMTP_PASS={{ vault_smtp_pass | default('') }}
SMTP_FROM="{{ website_smtp_from | default('') }}"
SMTP_TO={{ website_smtp_to | default('') }}

LEGAL_ADDRESS="{{ website_legal_address | default('') }}"
LEGAL_EMAIL={{ website_legal_email | default('') }}
LEGAL_HOST="{{ website_legal_host | default('') }}"

SESSION_PASSWORD={{ vault_session_password | default('') }}
ADMIN_EMAILS={{ website_admin_emails | default([]) | join(',') }}
OIDC_ISSUER={{ website_oidc_issuer | default('') }}
OIDC_CLIENT_ID={{ website_oidc_client_id | default('') }}
OIDC_CLIENT_SECRET={{ vault_oidc_client_secret | default('') }}
OIDC_REQUIRE_MFA={{ website_oidc_require_mfa | default(true) | string | lower }}
OIDC_MFA_ACR={{ website_oidc_mfa_acr | default('') }}
DISCLOSURE_CONTACT={{ website_disclosure_contact | default('') }}
DISCLOSURE_ENCRYPTION_URL={{ website_disclosure_encryption_url | default('') }}

DEMO_URL={{ website_demo_url | default('') }}
DEMO_USER={{ website_demo_user | default('') }}
DEMO_PASSWORD={{ website_demo_password | default('') }}

BOOKING_ENABLED={{ website_booking_enabled | default(false) | string | lower }}
BOOKING_TIMEZONE={{ website_booking_timezone | default('Europe/Paris') }}
BOOKING_DAYS={{ website_booking_days | default([1, 2, 3, 4, 5]) | join(',') }}
BOOKING_TIMES={{ website_booking_times | default(['10:00', '14:00', '16:00']) | join(',') }}
BOOKING_DURATION_MIN={{ website_booking_duration_min | default(30) }}
BOOKING_HORIZON_DAYS={{ website_booking_horizon_days | default(14) }}
BOOKING_MIN_NOTICE_HOURS={{ website_booking_min_notice_hours | default(24) }}
BOOKING_MEETING_URL={{ website_booking_meeting_url | default('') }}
BOOKING_BUSY_ICS_URL={{ vault_booking_busy_ics_url | default('') }}
BOOKING_FEED_KEY={{ vault_booking_feed_key | default('') }}

ACCOUNTS_SECRET={{ vault_accounts_secret | default('') }}
ACCOUNTS_BREACH_CHECK={{ website_accounts_breach_check | default(true) | string | lower }}
ACCOUNTS_GITHUB_CLIENT_ID={{ website_accounts_github_client_id | default('') }}
ACCOUNTS_GITHUB_CLIENT_SECRET={{ vault_accounts_github_client_secret | default('') }}

{% if website_analytics_enabled %}
ANALYTICS_SRC=https://stats.{{ website_domain[4:] if website_domain is match('^www\\.') else website_domain }}/script.js
ANALYTICS_WEBSITE_ID={{ website_analytics_website_id | default('') }}
UMAMI_DB_PASSWORD={{ vault_umami_db_password }}
UMAMI_APP_SECRET={{ vault_umami_app_secret }}
{% endif %}
